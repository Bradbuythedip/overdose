__pycache__/
*.pyc
*.pyo

# session-generated large/derived artifacts
solver/strips/
solver/wf/__pycache__/
solver/solver_ledger.sqlite
solver/serial_matches.tsv
solver/serial_exhaust_*.tsv
solver/verify_hit_addrs.txt
solver/verify_hit_manifest.tsv
solver/everfunded_cache.jsonl
solver/*_sweep.log
solver/chain_tail_hits.*
solver/sweep_hits.*
solver/*_state.json

# transient run output from long sweeps (regenerated by re-running).
# NOTE: a hits file with actual content is evidence -- force-add it (git add -f)
# with the run context rather than letting these patterns hide it.
solver/*.log
solver/mega_hits_*.tsv
solver/*.out

# Workflow lens working dirs (overdose-violent-sweep). The GENERATORS are the
# reproducible method and are committed; the candidate lists they emit are
# megabytes of regenerable derived data. .hits files are kept -- a non-empty
# one is evidence.
# General: bulk .txt/.log inside solver subdirectories is lens output.
# The three dirs holding TRACKED files are explicitly re-included -- without
# these negations this rule would swallow 36 committed files including the page
# transcripts and the corpora_phrases sets.
solver/*/*.txt
solver/*/*.log
solver/*/*.out
solver/*/*.err
!solver/corpora_phrases/**
!solver/transcript/**
!solver/wf/**

# index-cipher candidate lists: regenerable from index_cipher.py and
# bip39_index.py. valid_mnemonics.txt is KEPT -- it is the result.
solver/index_cipher_candidates.txt
solver/bip39_index_candidates.txt
solver/index_all_candidates.txt
